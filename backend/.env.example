# Nyaya AI Backend Environment Settings Template
PROJECT_NAME="Nyaya AI"
VERSION="1.0.0"

# Local Ollama Inference (Zero external commercial API dependencies)
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:7b"
OLLAMA_TIMEOUT_SECONDS=90.0

# Security & Secret Key
SECRET_KEY="replace-with-a-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite / Database
DATABASE_URL="sqlite:///./nyaya_ai.db"

# Storage Directories
UPLOAD_DIR="./data/uploads"
VECTOR_STORE_DIR="./data/vector_store"
LEGAL_DOCS_DIR="./data/legal_documents"

# Embeddings
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
